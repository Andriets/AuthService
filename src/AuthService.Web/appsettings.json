{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Issuer": "AuthService",
    "Audience": "AuthService",
    "AccessTokenLifetimeHours": 6,
    "RefreshTokenLifetimeDays": 30
  }
}
